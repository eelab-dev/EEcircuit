{
  "name": "eecircuit",
  "source": "index.html",
  "version": "0.0.1",
  "description": "Circuit Simulator",
  "type": "module",
  "scripts": {
    "dev": "vite --force --port 5173 --host",
    "build": "vite build && ./copy_workers.sh",
    "preview": "vite preview",
    "lint": "eslint",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && tsc -p tests/tsconfig.json --noEmit && eslint .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run build && npm run check:chunks && playwright test --project=chrome --workers=1",
    "check:chunks": "node scripts/check-chunk-graph.mjs",
    "test:preview": "npm run build && npm run check:chunks && playwright test --project=chrome tests/preview",
    "test:unit": "vitest run",
    "test:videos": "playwright test --config=video.config.ts --project=videos --workers=1",
    "test:all": "npm run test:unit && npm test",
    "deploy": "wrangler deploy"
  },
  "author": "Danial Chitnis",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.1",
    "@danchitnis/svg-to-pdf": "^1.0.0",
    "@lucide/svelte": "^1.38.0",
    "eecircuit-engine": "^1.7.0",
    "eecircuit-schematic": "file:../EEcircuit-schematic",
    "monaco-editor": "0.56.0",
    "svelte": "^5.57.0",
    "webgl-plot": "^1.1.2"
  }
}
